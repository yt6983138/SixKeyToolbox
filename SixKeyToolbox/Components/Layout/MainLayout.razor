@inherits LayoutComponentBase

<div class="page">
    <header>
        <nav>
            <a href="/" class="@IsActive("/")">Home</a>
            <a href="/difficulty" class="@IsActive("/difficulty")">Difficulty</a>
            <a href="/rating" class="@IsActive("/rating")">Rating</a>
            <a href="/dan-split" class="@IsActive("/dan-split")">Dan Split</a>
            <a href="/dan-calc" class="@IsActive("/dan-calc")">Dan Calc</a>
            <a href="/ln-convert" class="@IsActive("/ln-convert")">LN Convert</a>
            <a href="/config" class="@IsActive("/config")">Config</a>
        </nav>
    </header>
    <main>
        @Body
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    [Parameter]
    public string? ActivePath { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string IsActive(string href)
    {
        string path = this.HttpContext?.Request.Path.Value ?? "/";
        bool active = href == "/" ? path == "/" : path.StartsWith(href, StringComparison.OrdinalIgnoreCase);
        return active ? "is-active" : "";
    }
}
