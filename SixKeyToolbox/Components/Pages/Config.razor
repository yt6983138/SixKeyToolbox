@page "/config"

<PageTitle>Config — SixKeyToolbox</PageTitle>

<WinDialog Title="Global Configuration">
    <section>
        <h3>General settings</h3>
        <label class="fullwidth">
            osu! base folder
            <input type="text" @bind="this.Settings.OsuBaseFolder" />
            <span class="muted">The root of your osu! install (contains <c>osu!.db</c>, <c>scores.db</c>, and the <c>Songs</c> folder)</span>
        </label>
        <div class="format-row">
            <label>
                Accuracy format
                <input type="text" @bind="this.Settings.AccuracyFormat" placeholder="F2" />
            </label>
            <label>
                Chart constant format
                <input type="text" @bind="this.Settings.ChartConstantFormat" placeholder="F2" />
            </label>
        </div>
        <p class="muted">Format strings control decimal places (e.g., "F2" = 2 decimals, "F1" = 1 decimal)</p>
        <button @onclick="this.SaveSettings">Save settings</button>
        @if (this.SettingsMessage is not null)
        {
            <span class="@this.SettingsClass">@this.SettingsMessage</span>
        }
    </section>

    <section>
        <h3>Dan presets</h3>
        <p class="muted">Saved dan definitions used by the Dan Calculating page. 
            You can also save one with better UI in the dan split page</p>
        @if (this.DanPresets.Count == 0)
        {
            <p class="muted">No presets saved yet.</p>
        }
        else
        {
            <div class="preset-list">
                @for (int i = 0; i < this.DanPresets.Count; i++)
                {
                    int idx = i;
                    <div class="preset-item">
                        <div class="preset-header">
                            <label>
                                Preset name
                                <input type="text" @bind="this.DanPresets[idx].Name" />
                            </label>
                            <button @onclick="() => this.RemovePreset(idx)">Remove</button>
                        </div>
                        <div class="preset-sections">
                            @for (int s = 0; s < this.DanPresets[idx].Sections.Count; s++)
                            {
                                int sIdx = s;
                                <div class="section-row">
                                    <label>
                                        Name
                                        <input type="text" @bind="this.DanPresets[idx].Sections[sIdx].Name" />
                                    </label>
                                    <label>
                                        Start (ms)
                                        <input type="number" min="0" @bind="this.DanPresets[idx].Sections[sIdx].StartMilliseconds" />
                                    </label>
                                    <label>
                                        Note count
                                        <input type="number" min="0" @bind="this.DanPresets[idx].Sections[sIdx].NoteCount" />
                                    </label>
                                    <label>
                                        LN count
                                        <input type="number" min="0" @bind="this.DanPresets[idx].Sections[sIdx].LNCount" />
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        <button @onclick="this.AddPreset">Add empty preset</button>
        <button @onclick="this.SavePresets">Save presets</button>
        @if (this.PresetsMessage is not null)
        {
            <span class="@this.PresetsClass">@this.PresetsMessage</span>
        }
    </section>
</WinDialog>

<style>
    section { margin-bottom: 1.5rem; }
    section h3 { margin: 0 0 .75rem; }
    .fullwidth { display: flex; flex-direction: column; margin-bottom: .75rem; gap: .25rem; }
    .fullwidth input { width: 100%; max-width: 40rem; }
    .fullwidth .muted { font-size: .9rem; }
    .format-row { display: flex; gap: 1rem; margin-bottom: .75rem; }
    .format-row label { display: flex; flex-direction: column; }
    .format-row input { width: 8rem; }
    .preset-list { display: flex; flex-direction: column; gap: 1.5rem; margin-bottom: 1rem; }
    .preset-item { border: 1px solid var(--dialog-border, #444); padding: 1rem; }
    .preset-header { display: flex; gap: 1rem; align-items: flex-end; margin-bottom: 1rem; }
    .preset-header label { flex: 1; max-width: 20rem; }
    .preset-sections { display: flex; flex-direction: column; gap: .5rem; }
    .section-row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .75rem; padding: .75rem; background: rgba(255,255,255,.02); }
    .section-row label { display: flex; flex-direction: column; font-size: .9rem; }
    .section-row input { margin-top: .25rem; }
    button { margin-right: .5rem; }
    .muted { opacity: .6; }
    .ok { color: #6fcf6f; }
    .err { color: #e06666; }
</style>
