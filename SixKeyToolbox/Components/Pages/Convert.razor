@page "/convert"

<PageTitle>Convert — SixKeyToolbox</PageTitle>

<WinDialog Title="Beatmap Converting">
    <p class="muted">Pick a folder of beatmaps to convert. Each <c>.osu</c> is processed and written back to the same folder with a suffix. Existing files are overwritten.</p>

    <div class="row">
        <label>
            Conversion mode
            <select @bind="this.Mode">
                <option value="@ConversionMode.InverseLN">Inverse LN</option>
                <option value="@ConversionMode.SevenKToSixK">7K to 6K (delete spacebar)</option>
                <option value="@ConversionMode.ColumnMapping">Column Mapping</option>
            </select>
        </label>
    </div>

    @if (this.Mode == ConversionMode.InverseLN)
    {
        <p class="muted">Converts 6K beatmaps to inverse: every note except the last per column becomes an LN ending <c>gap</c> before the next note. Output suffix: <c>@("@Inverse")</c></p>
        <div class="row">
            <label>
                Gap
                <select @bind="this.GapPreset">
                    @foreach (var g in GapPresets)
                    {
                        <option value="@g">@g</option>
                    }
                </select>
            </label>
            <label>
                OD
                <input type="number" step="0.1" min="0" max="10" @bind="this.OverallDifficulty" />
            </label>
        </div>
    }
    else if (this.Mode == ConversionMode.SevenKToSixK)
    {
        <p class="muted">Converts 7K beatmaps to 6K by removing the middle column (spacebar) and remapping the remaining columns. Output suffix: <c>@("@7to6DelSpace")</c></p>
    }
    else if (this.Mode == ConversionMode.ColumnMapping)
    {
        <p class="muted">Maps source columns to target columns using a custom layout. Each target column is filled from a source column number (1-indexed, 0 = empty). Output suffix: <c>@("@ColMap")</c></p>
        <div class="row">
            <label>
                Target key count
                <input type="number" min="1" max="18" @bind="this.TargetKeyCount" @bind:after="this.UpdateMappingArray" />
            </label>
        </div>
        <div class="mapping-grid">
            <p class="muted">Column mapping (0 = empty, 1 = 1st source column, 2 = 2nd source column, etc.):</p>
            <div class="mapping-inputs">
                @for (int i = 0; i < this.TargetKeyCount; i++)
                {
                    int idx = i;
                    <label class="mapping-col">
                        Col @(i + 1)
                        <input type="number" min="0" @bind="this.ColumnMappings[idx]" />
                    </label>
                }
            </div>
        </div>
    }

    <div class="row">
        <button @onclick="this.PickFolder">Pick folder</button>
    </div>

    @if (this.AvailableFiles.Count > 0)
    {
        <div class="row">
            <p class="muted">Select files to convert:</p>
        </div>
        <table class="file-selection">
            <tr>
                <th>Should Convert</th>
                <th>File</th>
            </tr>
            @foreach (var file in this.AvailableFiles)
            {
                <tr>
                    <td><input type="checkbox" @bind="file.IsSelected" /></td>
                    <td>@file.FileName</td>
                </tr>
            }
        </table>
        <div class="row">
            <button @onclick="this.ConvertSelected">Done Selecting</button>
        </div>
    }

    @if (this.ResultMessage is not null)
    {
        <p class="@this.ResultClass">@this.ResultMessage</p>
    }
    @if (this.ConvertedFiles.Count > 0)
    {
        <ul>
            @foreach (var f in this.ConvertedFiles)
            {
                <li>@f</li>
            }
        </ul>
    }
</WinDialog>

<style>
    .row { display: flex; gap: 1rem; align-items: end; flex-wrap: wrap; margin-bottom: 1rem; }
    label { display: flex; flex-direction: column; }
    .muted { opacity: .6; }
    .ok { color: #6fcf6f; }
    .err { color: #e06666; }
    .mapping-grid { margin-bottom: 1rem; }
    .mapping-inputs { display: grid; grid-template-columns: repeat(auto-fill, minmax(5rem, 1fr)); gap: .75rem; max-width: 40rem; }
    .mapping-col { font-size: .9rem; }
    .mapping-col input { width: 100%; }
    .file-selection { margin: 1rem 0; }
    .file-list { display: flex; flex-direction: column; gap: .5rem; max-height: 20rem; overflow-y: auto; padding: .5rem; border: 1px solid var(--dialog-border, #444); margin-bottom: 1rem; }
    .file-item { display: flex; align-items: center; gap: .5rem; }
    .file-item input[type="checkbox"] { margin: 0; }
</style>
