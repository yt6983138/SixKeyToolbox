@page "/ln-convert"

<PageTitle>LN Convert — SixKeyToolbox</PageTitle>

<WinDialog Title="LN Converting">
    <p class="muted">Pick a folder of 6K beatmaps. Each <c>.osu</c> is converted to inverse (every note except the last per column becomes an LN ending <c>gap</c> before the next), and written back to the same folder with an <c>@("@Inverse")</c> suffix. Existing files are overwritten.</p>

    <div class="row">
        <button @onclick="this.PickAndConvert">Pick folder &amp; convert</button>
    </div>

    <div class="row">
        <label>
            Gap
            <select @bind="this.GapPreset">
                @foreach (var g in GapPresets)
                {
                    <option value="@g">@g</option>
                }
            </select>
        </label>
        <label>
            OD
            <input type="number" step="0.1" min="0" max="10" @bind="this.OverallDifficulty" />
        </label>
    </div>

    @if (this.ResultMessage is not null)
    {
        <p class="@this.ResultClass">@this.ResultMessage</p>
    }
    @if (this.ConvertedFiles.Count > 0)
    {
        <ul>
            @foreach (var f in this.ConvertedFiles)
            {
                <li>@f</li>
            }
        </ul>
    }
</WinDialog>

<style>
    .row { display: flex; gap: 1rem; align-items: end; flex-wrap: wrap; margin-bottom: 1rem; }
    label { display: flex; flex-direction: column; }
    .muted { opacity: .6; }
    .ok { color: #6fcf6f; }
    .err { color: #e06666; }
</style>
